{
	"name": "hd-cms-prototype",
	"version": "1.0.0",
	"description": "A blank template to get started with Payload 3.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"check": "biome ci .",
		"check:write": "biome check --write .",
		"ci": "pnpm run check && pnpm run typecheck && pnpm run test:int && pnpm run build",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"lint": "biome lint .",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start",
		"test": "pnpm run test:int && pnpm run test:e2e",
		"test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
		"test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
		"typecheck": "tsc --noEmit",
		"doctor": "pnpm run generate:types && pnpm run check:write && pnpm run check && pnpm run typecheck",
		"doctor:react": "npx react-doctor@latest"
	},
	"dependencies": {
		"@payloadcms/db-postgres": "3.85.1",
		"@payloadcms/next": "3.85.1",
		"@payloadcms/richtext-lexical": "3.85.1",
		"@payloadcms/storage-s3": "^3.85.1",
		"@payloadcms/translations": "^3.85.1",
		"cross-env": "^7.0.3",
		"dotenv": "16.4.7",
		"graphql": "^16.8.1",
		"next": "16.2.9",
		"payload": "3.85.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"sharp": "0.34.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@playwright/test": "1.61.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "22.19.9",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "4.5.2",
		"jsdom": "28.0.0",
		"tsx": "4.22.4",
		"typescript": "5.7.3",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": "^18.20.2 || >=20.9.0",
		"pnpm": "^9 || ^10"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp",
			"esbuild",
			"unrs-resolver"
		]
	},
	"packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
