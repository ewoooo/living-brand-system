# 복사해서 .env 로 쓰고 실제 값 채우기 (.env 는 git 에서 제외됨)

# PostgreSQL 연결 문자열.
# Supabase: Project Settings > Database > Connection string 에서 가져오되
# session 또는 direct connection(포트 5432)을 사용. transaction pooler(6543)는 마이그레이션이 깨지므로 금지.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# 충분히 길고 무작위인 시크릿. 운영에서 기본값/빈값 사용 금지.
PAYLOAD_SECRET=
