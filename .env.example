DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/hd_cms_prototype
PAYLOAD_SECRET=change-me

# Local development only. Leave unset or false in deployed environments.
PAYLOAD_DB_PUSH=true

# Production only. Enables Payload migrations during app startup.
PAYLOAD_RUN_MIGRATIONS_ON_STARTUP=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Image generation (OpenAI). Unset -> /api/image returns placeholders.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
